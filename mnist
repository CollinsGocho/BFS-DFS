        "from keras.datasets import mnist\n",
        "from keras.utils import to_categorical\n",
        "from keras import layers\n",
        "from keras import models\n",
        "from keras.layers import Input\n",
        "import numpy as np\n",
        "\n",
        "# Load and preprocess data\n",
        "(train_images, train_labels), (test_images, test_labels) = mnist.load_data()\n",
        "train_images_processed = train_images.reshape((60000, 28, 28, 1)).astype('float32') / 255\n",
        "test_images_processed = test_images.reshape((10000, 28, 28, 1)).astype('float32') / 255\n",
        "train_labels_categorical = to_categorical(train_labels)\n",
        "test_labels_categorical = to_categorical(test_labels)\n",
        "\n",
        "# Define the Input layer\n",
        "input_tensor = Input(shape=(28, 28, 1))\n",
        "\n",
        "# Build the model using the Functional API\n",
        "x = layers.Conv2D(64, (3, 3), activation='relu', padding=\"same\")(input_tensor)\n",
        "x = layers.MaxPooling2D((2, 2))(x)\n",
        "x = layers.Conv2D(64, (3, 3), activation='relu', padding=\"same\")(x)\n",
        "x = layers.MaxPooling2D((2, 2))(x)\n",
        "x = layers.Conv2D(64, (3, 3), activation='relu', padding=\"same\")(x)\n",
        "x = layers.Flatten()(x)\n",
        "x = layers.Dropout(0.5)(x)\n",
        "output_tensor = layers.Dense(10, activation='softmax')(x)\n",
        "\n",
        "model = models.Model(inputs=input_tensor, outputs=output_tensor)\n",
        "\n",
        "# Compile and train the model (ONLY 5 EPOCHS)\n",
        "model.compile(optimizer='rmsprop', loss='categorical_crossentropy', metrics=['accuracy'])\n",
        "model.fit(train_images_processed, train_labels_categorical, epochs=5, batch_size=64)\n",
        "\n",
        "# Evaluate the model on the test dataset\n",
        "test_loss, test_acc = model.evaluate(test_images_processed, test_labels_categorical)\n",
        "print(f\"Test Loss: {test_loss:.4f}\")\n",
        "print(f\"Test Accuracy: {test_acc:.4f}\")\n",
        "\n",
        "# PREDICT AND DISPLAY THE PREDICTED NUMBERS FOR FIRST 10 TEST IMAGES\n",
        "predictions = model.predict(test_images_processed[:10])\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"PREDICTION RESULTS (First 10 test images)\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "for i in range(10):\n",
        "    predicted_digit = np.argmax(predictions[i])\n",
        "    actual_digit = test_labels[i]\n",
        "    confidence = np.max(predictions[i]) * 100\n",
        "    print(f\"Image {i+1}: Predicted = {predicted_digit} | Actual = {actual_digit} | Confidence = {confidence:.2f}%\")\n",
        "\n",
        "# Optionally, predict for a specific image you provide\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"PREDICT FOR A SPECIFIC TEST IMAGE\")\n",
        "print(\"=\"*50)\n",
        "\n",
        "# Example: Predict for test image at index 42\n",
        "index_to_predict = 42\n",
        "single_prediction = model.predict(test_images_processed[index_to_predict:index_to_predict+1])\n",
        "predicted_number = np.argmax(single_prediction)\n",
        "confidence_score = np.max(single_prediction) * 100\n",
        "\n",
        "print(f\"Test Image #{index_to_predict}\")\n",
        "print(f\"Predicted Number: {predicted_number}\")\n",
        "print(f\"Actual Number: {test_labels[index_to_predict]}\")\n",
        "print(f\"Confidence: {confidence_score:.2f}%\")\n",
        "\n",
        "# Function to predict any image by its index\n",
        "def predict_image(index):\n",
        "    \"\"\"Predict the digit for a specific test image by its index\"\"\"\n",
        "    pred = model.predict(test_images_processed[index:index+1])\n",
        "    digit = np.argmax(pred)\n",
        "    conf = np.max(pred) * 100\n",
        "    print(f\"Image {index}: Predicted = {digit} | Actual = {test_labels[index]} | Confidence = {conf:.2f}%\")\n",
        "    return digit\n",
        "\n",
        "# Example usage of the function\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"USING THE PREDICT FUNCTION\")\n",
        "print(\"=\"*50)\n",
        "predict_image(100)  # Predict the 100th test image"
